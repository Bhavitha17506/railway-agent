# RailGuard AI - Environment Configuration Example

# Django Backend Configuration
DJANGO_SECRET_KEY=railguard-ai-secret-key-change-in-production-super-secure-38491
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (Defaults to MySQL, falls back to SQLite if unreachable)
DB_ENGINE=django.db.backends.mysql
DB_NAME=railguard_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# SQLite fallback option (Set USE_SQLITE=True to force SQLite for fast zero-config dev)
USE_SQLITE=False

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# AI & Processing Configuration
AI_CONFIDENCE_THRESHOLD=0.75
ENABLE_DEMO_INFERENCE=True
MAX_UPLOAD_SIZE_MB=50

# Frontend API URL (for Vite)
VITE_API_BASE_URL=http://127.0.0.1:8000/api
